# Airflow runtime (AIRFLOW_HOME when running natively)
airflow/
logs/
*.db
*.pid
airflow.cfg
simple_auth_manager_passwords.json.generated

# Tutorial artifacts
data/*
!data/.gitkeep
solutions/dbt_transforms/target/
solutions/dbt_transforms/logs/

# Reader workspace: files the reader writes while following the tutorial.
# The reference versions live in solutions/.
dags/*
!dags/.gitkeep
!dags/zz_broken_on_purpose.py
dbt/*
!dbt/.gitkeep

# Credentials: the GCP service-account key lives here (§9). Never commit it.
secrets/*
!secrets/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Env
.env

# Scratch
tmp/
