# Copy to .env before `docker compose up`:  cp env.example .env
#
# Linux / WSL2 only: make the container write files your host user can delete.
#   echo "AIRFLOW_UID=$(id -u)" >> .env
# On Docker Desktop for Windows/macOS you can leave the default.
AIRFLOW_UID=50000

# Signs the JWTs the workers use against the Task Execution API (Airflow 3).
AIRFLOW_JWT_SECRET=tutorial-jwt-secret-change-me

# Shared by every component; signs the api-server's requests for task logs.
AIRFLOW_SECRET_KEY=tutorial-secret-key-change-me

# Encrypts Connection/Variable secrets in the metadata DB. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=

# --- The data stack (§9) -----------------------------------------------------
# The ID of the GCP project you create in §9 (not its display name). The
# service-account key goes in secrets/gcp-key.json, never in this file.
GCP_PROJECT_ID=
# Where BigQuery keeps the dataset: US, EU, or a single region such as
# australia-southeast1 (https://cloud.google.com/bigquery/docs/locations).
# It must match the location you pick for the Airbyte destination.
BQ_LOCATION=US
